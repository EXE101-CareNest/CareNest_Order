		<PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.0.11" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
	</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CareNest_Order.Application\CareNest_Order.Application.csproj" />
    <ProjectReference Include="..\CareNest_Order.Infrastructure\CareNest_Order.Infrastructure.csproj" />
  </ItemGroup>

</Project>
